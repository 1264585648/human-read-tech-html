{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-read-tech-html.local/schemas/solution.schema.json",
  "title": "Human Read Tech HTML Solution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "scoping", "evidence", "blocks"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "brief": { "$ref": "#/$defs/brief" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string" },
        "version": { "type": "string" },
        "scope": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "scoping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullDesignRequired", "pressure", "reasons", "dimensions"],
      "properties": {
        "fullDesignRequired": { "type": "boolean" },
        "pressure": { "enum": ["low", "medium", "high"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changeScope", "dataChange", "callChain", "businessRisk", "performanceCapacity", "technicalUncertainty"],
          "properties": {
            "changeScope": { "$ref": "#/$defs/pressureLevel" },
            "dataChange": { "$ref": "#/$defs/pressureLevel" },
            "callChain": { "$ref": "#/$defs/pressureLevel" },
            "businessRisk": { "$ref": "#/$defs/pressureLevel" },
            "performanceCapacity": { "$ref": "#/$defs/pressureLevel" },
            "technicalUncertainty": { "$ref": "#/$defs/pressureLevel" }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "assumptions", "unknowns"],
      "properties": {
        "facts": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } }
      }
    },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "pressureLevel": { "enum": ["low", "medium", "high"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bottomLine", "keyChanges", "keyRisks"],
      "properties": {
        "bottomLine": { "type": "string", "minLength": 1 },
        "keyChanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "impact": { "type": "string", "minLength": 1 },
        "keyRisks": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "delivery": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "material": { "type": "boolean", "default": true }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "group"],
      "properties": {
        "role": { "enum": ["core", "detail", "reference"] },
        "group": { "enum": ["overview", "design", "decisions", "delivery", "details", "appendix"] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "importance", "reason", "representation", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["summary", "context", "goals", "change_set", "architecture", "flow", "interfaces", "data", "decisions", "non_functional", "rollout", "verification", "risks"] },
        "title": { "type": "string" },
        "importance": { "enum": ["high", "medium", "low"] },
        "reason": { "type": "string", "minLength": 1, "description": "Why this block is necessary. This is generator/reviewer metadata, not reader-facing body copy." },
        "reading": { "$ref": "#/$defs/reading" },
        "representation": { "$ref": "#/$defs/representation" },
        "content": { "description": "Structured block payload. Concrete block schemas will be added after V1 examples stabilize.", "type": ["object", "array", "string"] },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "engine", "reason"],
      "properties": {
        "kind": { "enum": ["text", "table", "cards", "architecture", "sequence", "workflow", "dataflow", "lifecycle", "er", "gantt"] },
        "engine": { "enum": ["native", "archify", "mermaid", "none"] },
        "reason": { "type": "string", "minLength": 1, "description": "Why this representation is better than a simpler alternative." },
        "spec": { "type": "object", "description": "Engine-specific typed source. Avoid storing generated SVG/HTML here." }
      }
    }
  }
}
