{
  "schemaVersion": "0.2",
  "title": "订单后处理异步化 V2 分层方案",
  "summary": "订单主事务只负责订单落库与可靠记录待发布事件，积分和通知通过 Kafka 异步完成。",
  "meta": { "status": "draft", "version": "v2", "scope": "Order Post-processing", "confidence": "medium" },
  "scoping": {
    "fullDesignRequired": true,
    "pressure": "high",
    "reasons": ["同步调用改为消息边界", "新增至少一次投递与幂等问题", "上线需要灰度与可回滚策略"],
    "dimensions": {
      "changeScope": "high",
      "dataChange": "medium",
      "callChain": "high",
      "businessRisk": "high",
      "performanceCapacity": "medium",
      "technicalUncertainty": "medium"
    }
  },
  "evidence": {
    "facts": [
      { "id": "fact-sync-postprocess", "text": "积分和通知当前位于订单创建同步请求链路。", "source": "示例现状" },
      { "id": "fact-isolation-goal", "text": "目标是让后处理故障不再直接扩大订单接口失败面。", "source": "示例目标" }
    ],
    "assumptions": [
      { "id": "assumption-at-least-once", "text": "订单事件采用至少一次投递，消费者通过 eventId 实现业务幂等。", "source": "方案假设", "material": true }
    ],
    "unknowns": [
      { "id": "unknown-kafka-capacity", "text": "现有 Kafka 峰值吞吐与分区容量需在上线前压测确认。", "source": "Research Gate", "material": true }
    ]
  },
  "concerns": [
    {
      "id": "async-messaging",
      "answers": {
        "delivery-semantics": { "status": "answered", "blockRefs": ["reliability"] },
        "idempotency": { "status": "answered", "blockRefs": ["reliability"], "evidenceRefs": ["assumption-at-least-once"] },
        "ordering": { "status": "answered", "blockRefs": ["reliability"] },
        "ack-boundary": { "status": "answered", "blockRefs": ["flow"] },
        "retry-dlq": { "status": "answered", "blockRefs": ["reliability"] },
        "failure-isolation": { "status": "answered", "blockRefs": ["architecture", "rollout"] },
        "observability": { "status": "answered", "blockRefs": ["reliability"] },
        "capacity": { "status": "answered", "blockRefs": ["risks"], "evidenceRefs": ["unknown-kafka-capacity"] }
      }
    }
  ],
  "model": {
    "blocks": [
      {
        "id": "context",
        "type": "context",
        "title": "为什么要改",
        "importance": "high",
        "reason": "需要先说明要解决的是同步链路故障耦合，而不是为了引入 Kafka。",
        "sourceRefs": ["fact-sync-postprocess", "fact-isolation-goal"],
        "content": { "body": "订单创建当前串行执行积分和通知，后处理抖动会直接放大接口延迟与失败面。" }
      },
      {
        "id": "architecture",
        "type": "architecture",
        "title": "目标边界",
        "importance": "high",
        "reason": "同步边界变成消息边界，是本次设计最核心的结构变化。",
        "sourceRefs": ["assumption-at-least-once"],
        "content": { "body": "订单主事务与后处理解耦；订单成功不再依赖积分或通知服务实时可用。" }
      },
      {
        "id": "flow",
        "type": "flow",
        "title": "订单创建与事件消费时序",
        "importance": "high",
        "reason": "事务提交、发布、消费和确认先后顺序直接决定是否丢消息或产生重复效果。",
        "content": { "body": "Outbox 与订单同事务提交，消费者完成幂等业务效果后再确认消费进度。" }
      },
      {
        "id": "decision",
        "type": "decisions",
        "title": "为什么选择 Transactional Outbox",
        "importance": "high",
        "reason": "直接双写和 Outbox 都是可行候选，但在丢消息风险上存在真实取舍。",
        "content": {
          "columns": [
            { "key": "option", "label": "方案" },
            { "key": "correctness", "label": "正确性" },
            { "key": "cost", "label": "复杂度" },
            { "key": "outcome", "label": "结论" }
          ],
          "rows": [
            { "option": "DB 成功后直接发 Kafka", "correctness": "存在数据库成功但发消息失败的双写窗口", "cost": "低", "outcome": "拒绝" },
            { "option": "Transactional Outbox", "correctness": "订单和待发布事件同事务，发布失败可重试", "cost": "中", "outcome": "采用" }
          ],
          "options": ["直接双写", "Transactional Outbox"]
        }
      },
      {
        "id": "reliability",
        "type": "non_functional",
        "title": "异步可靠性边界",
        "importance": "high",
        "reason": "消息语义、幂等、顺序、重试和可观测性决定异步系统是否可运营。",
        "sourceRefs": ["assumption-at-least-once"],
        "content": {
          "cards": [
            { "title": "投递语义", "body": "至少一次投递 + eventId 业务幂等，不宣称 exactly-once。" },
            { "title": "顺序", "body": "按 orderId 分区，只保证同订单事件顺序。" },
            { "title": "重试与 DLQ", "body": "指数退避，超过上限进入 DLQ，可按 eventId 重放。" },
            { "title": "观测", "body": "监控发布延迟、consumer lag、重试率、DLQ 数量和处理耗时。" }
          ]
        }
      },
      {
        "id": "rollout",
        "type": "rollout",
        "title": "灰度与回滚",
        "importance": "high",
        "reason": "同步切异步需要避免灰度期间双执行，并保留快速回切能力。",
        "content": {
          "columns": [
            { "key": "stage", "label": "阶段" },
            { "key": "behavior", "label": "行为" },
            { "key": "rollback", "label": "回退" }
          ],
          "rows": [
            { "stage": "影子发布", "behavior": "发布事件但消费者不产生业务效果", "rollback": "停止发布" },
            { "stage": "小流量异步", "behavior": "稳定分桶，桶内只走异步后处理", "rollback": "关闭异步桶并恢复同步" },
            { "stage": "全量", "behavior": "全部后处理由消费者执行", "rollback": "保留同步实现开关并按积压情况回切" }
          ]
        }
      },
      {
        "id": "verification",
        "type": "verification",
        "title": "怎么证明它不会丢、不会重、能恢复",
        "importance": "high",
        "reason": "高业务风险变更必须验证故障场景，而不只是验证接口变快。",
        "content": {
          "columns": [
            { "key": "scenario", "label": "场景" },
            { "key": "expected", "label": "期望" }
          ],
          "rows": [
            { "scenario": "DB 提交后发布进程崩溃", "expected": "Outbox 后续重试发布，事件不丢" },
            { "scenario": "同一事件重复投递", "expected": "eventId 幂等阻止重复积分或通知" },
            { "scenario": "消费者连续失败", "expected": "重试后进入 DLQ，订单主事务不回滚" }
          ]
        }
      },
      {
        "id": "risks",
        "type": "risks",
        "title": "上线前必须关闭的风险",
        "importance": "high",
        "reason": "Kafka 容量仍是材料未知项，必须有明确关闭条件。",
        "sourceRefs": ["unknown-kafka-capacity"],
        "content": {
          "columns": [
            { "key": "risk", "label": "风险" },
            { "key": "impact", "label": "影响" },
            { "key": "close", "label": "关闭条件" }
          ],
          "rows": [
            { "risk": "Kafka 分区或吞吐不足", "impact": "积压扩大、后处理延迟", "close": "按峰值事件率压测并确认分区与保留容量" }
          ]
        }
      }
    ]
  },
  "view": {
    "brief": {
      "bottomLine": "订单主事务只负责订单与 Outbox 同事务提交；积分和通知迁出同步请求，由 Kafka 消费并通过幂等、重试和 DLQ 保证可恢复。",
      "keyChanges": [
        "订单与 Outbox 同事务提交，消除 DB 成功但事件丢失的双写窗口。",
        "积分和通知改为至少一次消费，并通过 eventId 实现业务幂等。",
        "灰度期间同步与异步路径互斥，保留同步实现开关用于回退。"
      ],
      "impact": "订单接口成功语义仍以订单主事务提交为准；支付链路不变。",
      "keyRisks": ["Kafka 容量必须在上线前压测确认。"],
      "delivery": "影子发布 → 小流量异步 → 全量，并持续观察积压、重试和 DLQ。"
    },
    "groups": [
      {
