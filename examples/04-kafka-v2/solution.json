                    { "id": "db", "type": "database", "label": "订单数据库", "row": 1, "col": 1 },
                    { "id": "kafka", "type": "messagebus", "label": "Kafka", "row": 0, "col": 2 },
                    { "id": "consumer", "type": "backend", "label": "后处理消费者", "row": 0, "col": 3 },
