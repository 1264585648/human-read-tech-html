                "spec": {
                  "schema_version": 1,
                  "diagram_type": "architecture",
                  "meta": { "title": "订单异步后处理目标架构", "locale": "zh-CN", "quality_profile": "showcase" },
                  "layout": { "mode": "grid", "cols": 5, "gapX": 40, "gapY": 40, "cellW": 180, "cellH": 100 },
